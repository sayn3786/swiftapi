# ── Required ──────────────────────────────────────────
SWIFT_CONSUMER_KEY=your_consumer_key_here
SWIFT_CONSUMER_SECRET=your_consumer_secret_here

# ── Sandbox endpoints (no changes needed) ─────────────
SWIFT_BASE_URL=https://sandbox.swift.com
SWIFT_TOKEN_URL=https://sandbox.swift.com/oauth2/v1/token

# ── Scope (pick one for your API) ─────────────────────
# Messaging API  → swift.messaging.api
# SwiftRef       → (leave blank or omit)
# Pre-validation → swift.preval
# gpi Tracker    → swift.apitracker/FullViewer
SWIFT_SCOPE=swift.messaging.api

# ── PKI Certificate (only needed for Messaging API / JWT Bearer) ──
# Leave blank for sandbox client_credentials flow (SwiftRef, KYC, Analytics)
SWIFT_CERT_PATH=
SWIFT_KEY_PATH=
SWIFT_KEY_PASSWORD=
