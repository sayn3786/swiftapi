# ═══════════════════════════════════════════════════════
#  SWIFT API — Environment Variables Template
#  Copy to .env and fill in your values. Never commit .env
# ═══════════════════════════════════════════════════════

# ── 1. App credentials (developer.swift.com → Apps → Your App) ──────────────
SWIFT_CONSUMER_KEY=your_consumer_key_here
SWIFT_CONSUMER_SECRET=your_consumer_secret_here

# ── 2. License credentials (swift.com → My Profile → Admin → License ID) ────
#    Used as username + password in OAuth password grant body.
#    Requires a SWIFT contract. For sandbox without a contract,
#    email developer-support@swift.com to request sandbox credentials.
SWIFT_LICENSE_ID=your_license_id_here
SWIFT_LICENSE_SECRET=your_license_secret_here

# ── 3. PKI Certificate paths (only for Messaging API / JWT Bearer flow) ──────
#    Leave blank for SwiftRef, KYC, Analytics (password grant is enough)
SWIFT_CERT_PATH=
SWIFT_KEY_PATH=

# ── 4. Endpoints (no changes needed for sandbox) ─────────────────────────────
SWIFT_BASE_URL=https://sandbox.swift.com
SWIFT_TOKEN_URL=https://sandbox.swift.com/oauth2/v1/token

# ── 5. Scope — leave blank for SwiftRef; set per API when needed ─────────────
#    SwiftRef          → (leave blank)
#    Messaging API     → swift.messaging.api
#    gpi Tracker       → swift.apitracker/FullViewer
#    Pre-validation    → swift.preval
#    gpi for Corp      → swift.apitracker-g4c
SWIFT_SCOPE=
